{
  "Function": {
    "prefix": "fn",
    "body": ["${1:name}() {", "  $0", "}"],
    "description": "Zsh function"
  },
  "If": {
    "prefix": "if",
    "body": ["if [[ ${1:condition} ]]; then", "  $0", "fi"],
    "description": "Zsh if block"
  },
  "For": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items}; do", "  $0", "done"],
    "description": "Zsh for loop"
  },
  "Case": {
    "prefix": "case",
    "body": ["case ${1:value} in", "  ${2:pattern})", "    $0", "    ;;", "esac"],
    "description": "Zsh case block"
  }
}
