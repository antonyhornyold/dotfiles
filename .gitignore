/*
!/.gitignore
!/bootstrap.sh
!/README.md
!/Brewfile
!/starship.toml
!/nvim/
!/ghostty/
!/zsh/
!/git/
!/bat/
!/lazygit/
!/bin/
/nvim/nvim.log
/**/.DS_Store
/nvim/CHEATSHEET.md
/zsh/.zcompcache/

# Track Herdr settings while excluding runtime state.
!/herdr/
/herdr/*
!/herdr/config.toml
!/herdr/workspace-status.py
!/herdr/battery-status.py

# Track Rex configuration and scripts, excluding other generated files.
!/rex/
/rex/*
!/rex/*.lua
!/rex/README.md
!/rex/scripts/
/rex/scripts/*
!/rex/scripts/*.lua
!/rex/scripts/README.md
